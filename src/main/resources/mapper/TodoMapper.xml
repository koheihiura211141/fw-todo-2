<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.todoapp.TodoMapper">
    <sql id="searchConditions">
        <where>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="priority != null">
                AND priority = #{priority}
            </if>
            <if test="completed != null">
                AND completed = #{completed}
            </if>
            <if test="from != null">
                AND due_date &gt;= #{from}
            </if>
            <if test="to != null">
                AND due_date &lt;= #{to}
            </if>
        </where>
    </sql>
    <select id="searchPage" resultType="com.example.todoapp.Todo">
        SELECT id, title, detail, category, priority, due_date AS deadline, completed, created_at, updated_at
        FROM todos
        <include refid="searchConditions"/>
        ORDER BY (due_date IS NULL) ASC, due_date
        <choose>
            <when test="order == 'desc'">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
        , id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="countSearch" resultType="long">
        SELECT COUNT(*) FROM todos
        <include refid="searchConditions"/>
    </select>
    <select id="findById" resultType="com.example.todoapp.Todo">
        SELECT id, title, detail, category, priority, due_date AS deadline, completed, created_at, updated_at
        FROM todos
        WHERE id = #{id}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todos (title, detail, category, priority, due_date, completed)
        VALUES (#{title}, #{detail}, #{category}, #{priority}, #{deadline}, COALESCE(#{completed}, FALSE))
    </insert>
    <update id="update">
        UPDATE todos
        SET title = #{title},
            detail = #{detail},
            category = #{category},
            priority = #{priority},
            due_date = #{deadline},
            completed = #{completed}
        WHERE id = #{id}
    </update>
    <delete id="deleteById">
        DELETE FROM todos
        WHERE id = #{id}
    </delete>
    <delete id="deleteByIds">
        DELETE FROM todos
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>WHERE 1 = 0</otherwise>
        </choose>
    </delete>
</mapper>
